  "id_pattern_dialect": "python-re",
  "node_types": {
    "DomainBundle": {
      "carrier": "docs/spec/{domain}/domain-map.md 或 docs/domain-map.md frontmatter",
      "id_pattern": "^DOMAIN-MAP-[a-z0-9-]+$",
      "layer": "established"
    },
    "EVT": {
      "carrier": "docs/events/{domain}/EVT-{DOMAIN}-NNN-{slug}.md frontmatter（載體形式為 per-file，已定案。曾評估集中式 registry，不採用：per-file 讓事件定義與其 domain 目錄同址、diff 粒度落在單一事件、新增事件不觸碰共用檔；registry 的收益在跨事件查詢，而該需求可由目錄掃描滿足。改採 registry 屬 schema 變更，需先提出 per-file 無法滿足的具體查詢或一致性需求。）",
      "id_pattern": "^EVT-[A-Z0-9]+-\\d{3}$",
      "layer": "proposed"
    },
    "FlowStep": {
      "carrier": "UC 文件內結構化 flow 區塊（YAML list）",
      "id_pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "layer": "proposed"
    },
    "PROP": {
      "carrier": "docs/proposals/PROP-NNN-{slug}.md frontmatter",
      "id_pattern": "^PROP-\\d{3}$",
      "layer": "established"
    },
    "SPEC": {
      "carrier": "docs/spec/{domain}/{slug}.md frontmatter",
      "id_pattern": "^SPEC-([0-9]{3}|[A-Z0-9-]+)$",
      "layer": "established"
    },
    "Ticket": {
      "carrier": "docs/work-logs/.../tickets/{id}.md frontmatter",
      "id_pattern": "^[\\w.]+-W\\d+-\\d+$",
      "layer": "established"
    },
    "UC": {
      "carrier": "docs/usecases/UC-NN-{slug}.md frontmatter",
      "id_pattern": "^UC-\\d{2,}$",
      "layer": "established"
    }
  },
  "notice": "本檔為 tracking_schema.py 的衍生產物，唯一 SSOT 為該 .py 檔。禁止直接編輯本 JSON，修改型別表請改 tracking_schema.py 後重新執行`doc schema export` 產生。",
